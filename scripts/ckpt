#!/bin/bash
# วิธีใช้: ckpt <URL>              (สำหรับ Illustrious/SDXL — ไม่ต้องมี arch)
#         ckpt zimage <URL>       (สำหรับ Z-Image — พิมพ์ "ckpt zimage " ก่อน แล้ววาง URL ต่อท้ายจบเลย)
source /workspace/scripts/common_download.sh

if [ "$1" == "zimage" ]; then
    ARCH="zimage"
    URL="$2"
else
    ARCH=""
    URL="$1"
fi

if [ -z "$URL" ]; then
    echo "วิธีใช้: ckpt <URL>"
    echo "        ckpt zimage <URL>   (พิมพ์ 'ckpt zimage ' ก่อน แล้ววาง URL ต่อท้าย)"
    exit 1
fi

echo "[ckpt] กำลังโหลด checkpoint ใหม่..."
download_asset "$URL" "/workspace/forge/models/Stable-diffusion"

if [ -n "$ARCH" ]; then
    ensure_model_arch_deps "$ARCH"
fi

echo "[ckpt] เสร็จแล้ว — กลับไปกด 🔄 Refresh ที่ dropdown checkpoint ใน Forge UI"
